{
    "app-id": "de.linuxundich.Gnomos",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "gnomos",
    "appstream-compose": false,
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--share=network",
        "--own-name=org.mpris.MediaPlayer2.gnomos",
        "--own-name=de.linuxundich.Gnomos.Zone"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "libsigc++",
            "buildsystem": "meson",
            "config-opts": ["-Dbuild-documentation=false", "-Dmaintainer-mode=false"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/libsigcplusplus/libsigcplusplus.git",
                    "tag": "3.6.0"
                }
            ]
        },
        {
            "name": "glibmm",
            "buildsystem": "meson",
            "config-opts": ["-Dbuild-documentation=false", "-Dmaintainer-mode=false"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/glibmm/2.90/glibmm-2.90.0.tar.xz",
                    "sha256": "e2efa45643f16b9fea2d6299f2f403d672eaeacddf0ff7f8094e1af9b0f5980b"
                }
            ]
        },
        {
            "name": "cairomm",
            "buildsystem": "meson",
            "config-opts": ["-Dbuild-documentation=false", "-Dmaintainer-mode=false"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://www.cairographics.org/releases/cairomm-1.16.2.tar.xz",
                    "sha256": "6a63bf98a97dda2b0f55e34d1b5f3fb909ef8b70f9b8d382cb1ff3978e7dc13f"
                }
            ]
        },
        {
            "name": "pangomm",
            "buildsystem": "meson",
            "config-opts": ["-Dbuild-documentation=false", "-Dmaintainer-mode=false"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/pangomm/2.58/pangomm-2.58.0.tar.xz",
                    "sha256": "217514c1a65035c2fce6e69e33b0d92bafa2594cc474e995a4473441b10f3a33"
                }
            ]
        },
        {
            "name": "gtkmm",
            "buildsystem": "meson",
            "config-opts": ["-Dbuild-documentation=false", "-Dbuild-demos=false", "-Dmaintainer-mode=false"],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gtkmm/4.24/gtkmm-4.24.0.tar.xz",
                    "sha256": "7fd9cea356e7d3b74bf7d2a51d7e0e6763f3f9f1cddc5e77c8b0b5b7fa9d5e5a"
                }
            ]
        },
        {
            "name": "gnomos",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ],
            "post-install": [
                "gtk4-update-icon-cache -f -t /app/share/icons/hicolor"
            ]
        }
    ]
}
