gnomos_sources = files(
  'main.cpp',
  'gnomos-application.cpp',
  'gnomos-window.cpp',
  'gnomos-window-history.cpp',
  'gnomos-window-library.cpp',
  'gnomos-window-rooms.cpp',
  'gnomos-window-settings.cpp',
  'mini-player-window.cpp',
  'mpris-service.cpp',
  'zone-volume-service.cpp',
  'global-shortcuts-service.cpp',
  'radio-content-filter.cpp',
  'window-helpers.cpp',
  'backend/noson-backend.cpp',
  'widgets/alarms-view.cpp',
  'widgets/art-cache.cpp',
  'widgets/art-decode-pool.cpp',
  'widgets/artist-image-fetcher.cpp',
  'widgets/artist-info-fetcher.cpp',
  'widgets/cover-palette.cpp',
  'widgets/cover-thumbnail.cpp',
  'widgets/dialog-shell.cpp',
  'widgets/favorites-view.cpp',
  'widgets/history-view.cpp',
  'widgets/http-fetch.cpp',
  'widgets/lastfm-scrobbler.cpp',
  'widgets/library-view.cpp',
  'widgets/listenbrainz-scrobbler.cpp',
  'widgets/lyrics-fetcher.cpp',
  'widgets/playback-ui.cpp',
  'widgets/playing-indicator.cpp',
  'widgets/now-playing-view.cpp',
  'widgets/player-bar.cpp',
  'widgets/queue-view.cpp',
  'widgets/radio-browser-service.cpp',
)

executable(
  'gnomos',
  gnomos_sources,
  gnomos_resources,
  config_h,
  include_directories: config_inc,
  dependencies: [gtkmm_dep, adwaita_dep, noson_dep, json_glib_dep, soup_dep, webp_dep],
  install: true,
)
