install_data(
  'de.linuxundich.Gnomos.desktop',
  install_dir: get_option('datadir') / 'applications',
)

install_data(
  'de.linuxundich.Gnomos.metainfo.xml',
  install_dir: get_option('datadir') / 'metainfo',
)

# App icon, symbolic icon and PNG renderings, all generated by
# build-aux/icons/generate_icons.py. The PNGs are needed on systems without a
# gdk-pixbuf SVG loader (GNOME Shell would show an empty tile, and Flatpak's
# export-time icon validation fails).
install_data(
  'icons/hicolor/scalable/apps/de.linuxundich.Gnomos.svg',
  install_dir: get_option('datadir') / 'icons/hicolor/scalable/apps',
)

install_data(
  'icons/hicolor/symbolic/apps/de.linuxundich.Gnomos-symbolic.svg',
  install_dir: get_option('datadir') / 'icons/hicolor/symbolic/apps',
)

foreach size : ['48', '64', '128', '256']
  install_data(
    'icons/hicolor/@0@x@0@/apps/de.linuxundich.Gnomos.png'.format(size),
    install_dir: get_option('datadir') / 'icons/hicolor/@0@x@0@/apps'.format(size),
  )
endforeach

# NOTE: translations (i18n.merge_file() + po/) are not wired up yet — see
# README.md roadmap. The .desktop/.metainfo files below are installed as
# plain, untranslated data files for now.
